{
  "name": "@boopdoopgoop/opencode-btw",
  "version": "0.1.2",
  "description": "A read-only BTW side-conversation plugin for OpenCode.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoopDoopGoop/opencode-config.git",
    "directory": "packages/opencode-btw"
  },
  "bugs": {
    "url": "https://github.com/BoopDoopGoop/opencode-config/issues"
  },
  "homepage": "https://github.com/BoopDoopGoop/opencode-config/tree/main/packages/opencode-btw",
  "scripts": {
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "check": "bun run build && bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25"
  },
  "engines": {
    "opencode": ">=1.18.19"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
