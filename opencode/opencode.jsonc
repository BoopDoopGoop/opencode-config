{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 2,
  "autoupdate": "notify",
  "agent": {
    "plan": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "build": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "orchestrator": {
      "mode": "subagent"
    }
  },
  "provider": {
    "azure": {
      "options": {
        "baseURL": "https://intangibility-resource.services.ai.azure.com/openai/v1"
      }
    }
  },
  "permission": "allow",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@latest",
    "./plugins/caveman/plugin.js"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "lsp": true
}
