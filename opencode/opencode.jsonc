{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": "notify",
  "agent": {
    "plan": {
      "model": "vercel/openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "build": {
      "model": "vercel/openai/gpt-6-sol-fast",
      "variant": "low"
    }
  },
  "provider": {
    "vercel": {
      "models": {
        "openai/gpt-6-sol-fast": {
          "options": {
            "reasoningSummary": "auto"
          }
        }
      }
    },
    "azure": {
      "options": {
        "baseURL": "https://intangibility-resource.services.ai.azure.com/openai/v1"
      }
    }
  },
  "permission": "allow",
  "plugin": [],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium", "--user-data-dir", "/Users/henrycen/Library/Caches/ms-playwright-mcp/agent-browser-profile", "--idle-timeout", "300000"],
      "enabled": true
    }
  },
  "lsp": true
}
