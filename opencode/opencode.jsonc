{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": "notify",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "provider": {
    "azure": {
      "options": {
        "baseURL": "https://intangibility-resource.services.ai.azure.com/openai/v1"
      }
    }
  },
  "permission": "allow",
  "plugin": [
    "oh-my-opencode-slim",
    "@boopdoopgoop/opencode-btw"
  ],
  "lsp": true
}
