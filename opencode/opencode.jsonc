{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 2,
  "autoupdate": "notify",
  "agent": {
    "plan": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "build": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    }
  },
  "provider": {
    "azure": {
      "options": {
        "baseURL": "https://intangibility-resource.services.ai.azure.com/openai/v1"
      }
    }
  },
  "permission": "allow",
  "plugin": [],
  "lsp": true
}
